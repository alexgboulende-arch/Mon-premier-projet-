rules_version = '2';

// Règles de sécurité de la base Firestore de Buteo.
// À copier dans la console Firebase : Firestore Database > Règles > Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    // Champs écrits uniquement par le serveur (formule, achats) : l'app ne peut pas les modifier.
    function serverFields() {
      return ['tier', 'tierUntil', 'subscription', 'entitlements', 'coupons', 'purchases'];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profil de chaque utilisateur : équipes suivies, alertes, jeton de notification.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(serverFields());
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverFields());

      // Journal de paris : privé, écrit par l'utilisateur lui-même.
      match /journal/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['id', 'day', 'label', 'odds', 'stake', 'status', 'updatedAt'])
          && request.resource.data.id == entryId
          && request.resource.data.label is string && request.resource.data.label.size() <= 120
          && request.resource.data.odds is number && request.resource.data.odds >= 1 && request.resource.data.odds <= 1000
          && request.resource.data.stake is int && request.resource.data.stake > 0 && request.resource.data.stake <= 10000000
          && request.resource.data.status in ['pending', 'won', 'lost', 'refunded'];
      }
    }

    // Pronos publiés par le moteur. Gratuit : lisible par tous. VIP : réservé à la
    // formule correspondante ou à un coupon du jour, puis public le lendemain
    // (l'historique reste transparent). Un document absent peut être demandé.
    match /picks/{id} {
      allow read: if resource == null
        || resource.data.tier == 'free'
        || resource.data.publicAfter <= request.time
        || (request.auth != null
            && entitled(resource.data.tier, resource.data.date, resource.data.rubric));
      allow write: if false;
    }

    // Statistiques et état du moteur : publics, écrits seulement par le moteur.
    match /stats/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /config/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Concours « Pronos du jour » : matchs publiés par le moteur, pronos des joueurs
    // acceptés seulement avant le coup d'envoi (heure lue dans le concours).
    match /contests/{date} {
      allow read: if true;
      allow write: if false;

      match /picks/{pickId} {
        allow read: if request.auth != null && resource.data.uid == request.auth.uid;
        allow delete: if false;
        allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'fixtureId', 'choice', 'pseudo', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.fixtureId is int
          && pickId == request.auth.uid + '_' + string(request.resource.data.fixtureId)
          && request.resource.data.choice in ['1', 'X', '2']
          && request.resource.data.pseudo is string
          && request.resource.data.pseudo.matches('^[\\p{L}\\p{N} ._-]{3,20}$')
          && get(/databases/$(database)/documents/contests/$(date)).data.kickoffs[string(request.resource.data.fixtureId)] > request.time;
      }
    }

    // Points, classements et badges du concours : publics, calculés par le moteur.
    match /contestScores/{date} {
      allow read: if true;
      allow write: if false;
    }
    match /leaderboards/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /contestPlayers/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Commandes du site (Mobile Money, crypto) : créées et validées par le serveur,
    // lisibles par leur auteur pour suivre le paiement.
    match /orders/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Formule (jusqu'à son échéance) et coupons sont écrits par le serveur
    // après vérification du paiement (functions/src/purchases.ts).
    function entitled(tier, date, rubric) {
      let profile = get(profilePath()).data;
      let active = profile.get('tierUntil', timestamp.value(0)) > request.time;
      return exists(profilePath()) && (
        (tier == 'pro' && active && profile.get('tier', 'free') in ['pro', 'elite'])
        || (tier == 'elite' && active && profile.get('tier', 'free') == 'elite')
        || (date + '|' + rubric) in profile.get('coupons', [])
      );
    }

    // Tout le reste est fermé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
